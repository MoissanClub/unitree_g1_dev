# Unitree G1 PC2 hardware profile.
# Update this file after rewiring hardware, then rerun the relevant setup script.
# Values are shell assignments; quote values containing spaces.

G1_HARDWARE_CONFIGURED=1

# Robot network
G1_ROBOT_IP="192.168.123.161"
G1_PC2_WIRED_CIDR="192.168.123.164/24"
G1_DDS_IFACE="enP8p1s0"
G1_WIFI_IFACE="wlx94ba06f341b5"

# BrainCo Revo2 dual-hand FTDI adapter. Prefer stable /dev/serial/by-id paths.
G1_BRAINCO_LEFT_PORT="/dev/serial/by-id/usb-FTDI_USB__-__Serial_Converter_FTA1LW3T-if02-port0"
G1_BRAINCO_RIGHT_PORT="/dev/serial/by-id/usb-FTDI_USB__-__Serial_Converter_FTA1LW3T-if01-port0"
G1_BRAINCO_FTDI_SERIAL="FTA1LW3T"

# Head camera. This PC2 currently has a RealSense D435i on USB port 1-3.
# A native RealSense serial was not exposed by sysfs, so OpenCV is the
# configured default. Of the 6 v4l2 nodes this D435i exposes (video0-5),
# only video2 and video4 open as plain UVC capture; video2 is the IR/depth
# visualization stream (flat U/V, effectively grayscale) and video4 is the
# actual RGB color sensor - confirmed by inspecting captured frames. Keep
# the physical path recorded for rewiring checks.
G1_HEAD_CAMERA_BACKEND="opencv"
G1_HEAD_CAMERA_VIDEO_ID="4"
G1_HEAD_CAMERA_REALSENSE_SERIAL=""
G1_HEAD_CAMERA_PHYSICAL_PATH="platform-3610000.usb-usb-0:3"

# MID-360 LiDAR
G1_LIDAR_IP="192.168.123.120"
G1_LIDAR_TOPIC="/utlidar/cloud_livox_mid360"
G1_LIDAR_FRAME="livox_frame"

# Software/hardware model choices tied to this PC2 image.
G1_ROS_DISTRO="humble"
G1_ROBOT_DOF="29"

# Stable local software layout
G1_UNITREE_ROS2_DIR="${HOME}/unitree_ros2"
G1_UNITREE_SDK2_DIR="${HOME}/unitree_sdk2"
G1_BRAINCO_CHECKOUT_DIR="${HOME}/unitree-g1-brainco-hand"
G1_BRAINCO_BASE_DIR="${HOME}/g1-brainco"
G1_G1_DESCRIPTION_DIR="${HOME}/g1_description"
G1_BRAINCO_CONDA_ENV="g1brainco"
G1_XR_REPO_DIR="${HOME}/xr_teleoperate"
G1_XR_CONDA_ENV="tv"
