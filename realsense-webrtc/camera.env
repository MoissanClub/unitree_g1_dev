# Empty means: find the RealSense V4L2 node that exposes 1920x1080 YUYV at 30 fps.
# D435i by-id names can collide across its depth/color UVC interfaces. If more
# than one camera is present, prefer the color interface's by-path link.
CAMERA_DEVICE=

WIDTH=1920
HEIGHT=1080
FPS=30

# nvv4l2h264enc bitrate is in bits per second. 8 Mbit/s is a good 1080p30
# low-latency starting point; raise it for detailed scenes or lower it for Wi-Fi.
BITRATE=8000000
GOP=30

# auto probes DMABUF first and falls back to mmap when the UVC driver cannot
# export buffers in a form accepted by nvvidconv.
V4L2_IO_MODE=auto

STREAM_PATH=d435
RTSP_URL=rtsp://127.0.0.1:8554/d435

# Override for troubleshooting, for example GST_DEBUG=3.
GST_DEBUG=2
